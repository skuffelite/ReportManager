# Discord bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Channel ID where reports get posted (right-click channel -> Copy Channel ID, needs Developer Mode on)
REPORT_CHANNEL_ID=123456789012345678

# Roblox Open Cloud API key (create at create.roblox.com -> Open Cloud -> API Keys)
# Give it DataStore read + write for your universe
OPEN_CLOUD_KEY=your_open_cloud_key_here

# Your game's Universe ID (NOT place id). Found in Creator Dashboard -> game -> ... -> Copy Universe ID
UNIVERSE_ID=0000000000

# How often (seconds) the bot checks for new reports
POLL_SECONDS=15

# Discord user IDs allowed to use the buttons (comma-separated). Only these people can
# change status, ban/unban, edit data. Leave empty to allow everyone (not recommended).
ADMIN_IDS=123456789012345678
